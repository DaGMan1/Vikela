{
  "manifest_version": 3,
  "name": "Vikela",
  "version": "2.0.0",
  "description": "Vikela \u2014 Know everyone who emails you. Sender intelligence, email history, OSINT.",
  "icons": {
    "16": "src/assets/icon16.png",
    "32": "src/assets/icon32.png",
    "48": "src/assets/icon48.png",
    "128": "src/assets/icon128.png"
  },
  "permissions": [
    "sidePanel",
    "scripting",
    "activeTab",
    "storage",
    "alarms",
    "tabs",
    "identity"
  ],
  "host_permissions": [
    "https://mail.google.com/*",
    "https://rdap.org/*",
    "https://haveibeenpwned.com/*",
    "https://api.hunter.io/*",
    "https://www.googleapis.com/*"
  ],
  "background": {
    "service_worker": "build/background.bundle.js"
  },
  "action": {
    "default_title": "Open Vikela",
    "default_icon": {
      "16": "src/assets/icon16.png",
      "32": "src/assets/icon32.png",
      "48": "src/assets/icon48.png",
      "128": "src/assets/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "src/sidebar/index.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://mail.google.com/*"
      ],
      "js": [
        "build/content.bundle.js"
      ],
      "css": [
        "src/content/halo.css"
      ],
      "run_at": "document_idle",
      "all_frames": false,
      "world": "MAIN"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/assets/*"
      ],
      "matches": [
        "https://mail.google.com/*"
      ]
    }
  ],
  "oauth2": {
    "client_id": "330853523987-01dv9edipno8fiani8bh225f7es3as32.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/gmail.readonly",
      "https://www.googleapis.com/auth/contacts.readonly"
    ]
  }
}