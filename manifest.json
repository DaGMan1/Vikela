{
  "manifest_version": 3,
  "name": "Vikela",
  "version": "2.0.0",
  "description": "Vikela \u2014 Know everyone who emails you. Sender intelligence, email history, OSINT.",
  "icons": {
    "48": "src/assets/icon.png",
    "128": "src/assets/icon.png"
  },
  "permissions": [
    "sidePanel",
    "scripting",
    "activeTab",
    "storage",
    "alarms",
    "tabs"
  ],
  "host_permissions": [
    "https://mail.google.com/*",
    "https://rdap.org/*",
    "https://haveibeenpwned.com/*",
    "https://api.hunter.io/*"
  ],
  "background": {
    "service_worker": "build/background.bundle.js"
  },
  "action": {
    "default_title": "Open Vikela",
    "default_icon": {
      "48": "src/assets/icon.png"
    }
  },
  "side_panel": {
    "default_path": "src/sidebar/index.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://mail.google.com/*"
      ],
      "js": [
        "src/content/scraper.js"
      ],
      "css": [
        "src/content/halo.css"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/assets/*"
      ],
      "matches": [
        "https://mail.google.com/*"
      ]
    }
  ]
}